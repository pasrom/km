# The km e2e driver's environment (e2e/README.md). Copy outside the repository, fill in, `source` it.
export KM_E2E_ORG=example-sandbox-org
export KM_E2E_REPO=example-brain
export KM_E2E_MOUNT_REPO=example-notes
export KM_E2E_MAINT_LOGIN=example-maintainer
export KM_E2E_MAINT_TOKEN_FILE=$HOME/.config/example-maintainer/token
export KM_E2E_CONTRIB_LOGIN=example-contributor
export KM_E2E_CONTRIB_GH_CONFIG_DIR=$HOME/.config/example-contributor-gh
export KM_E2E_MUST_NOT_REACH=example-real-org/example-real-brain
export KM_E2E_BASELINE_REF=0000000000000000000000000000000000000000
export KM_E2E_CANDIDATE_REF=0000000000000000000000000000000000000000
export KM_E2E_WORKDIR=$HOME/.cache/km-e2e
# export KM_E2E_DENY_FILE=$HOME/.config/km-e2e/deny.txt
